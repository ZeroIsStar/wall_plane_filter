Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 30; 30; 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground grid
    Enabled: true
    Plane: XY
    Cell Size: 1.0
    Plane Cell Count: 30
  - Class: rviz_default_plugins/PointCloud2
    Name: Camera 1 filtered
    Enabled: true
    Topic:
      Value: /wall_plane_filter/camera1/depth_cloud_filtered
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Queue Size: 5
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Camera 2 filtered
    Enabled: true
    Topic:
      Value: /wall_plane_filter/camera2/depth_cloud_filtered
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Queue Size: 5
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Camera 3 filtered
    Enabled: true
    Topic:
      Value: /wall_plane_filter/camera3/depth_cloud_filtered
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Queue Size: 5
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Camera 4 filtered
    Enabled: true
    Topic:
      Value: /wall_plane_filter/camera4/depth_cloud_filtered
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Queue Size: 5
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: Lidar filtered
    Enabled: true
    Topic:
      Value: /wall_plane_filter/cloud_filtered
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Color Transformer: AxisColor
    Position Transformer: XYZ
    Queue Size: 5
    Decay Time: 0
  - Class: rviz_default_plugins/MarkerArray
    Name: depth final walls
    Enabled: true
    Marker Topic:
      Value: /wall_plane_filter/depth_wall_markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Queue Size: 10
  - Class: rviz_default_plugins/MarkerArray
    Name: lidar final walls
    Enabled: true
    Marker Topic:
      Value: /wall_plane_filter/lidar_wall_markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Queue Size: 10
  - Class: rviz_default_plugins/Map
    Name: depth binary (debug)
    Enabled: false
    Topic:
      Value: /wall_plane_filter/depth_hough/binary
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Alpha: 0.5
    Color Scheme: map
    Draw Behind: true
  - Class: rviz_default_plugins/MarkerArray
    Name: depth stages (debug)
    Enabled: false
    Marker Topic:
      Value: /wall_plane_filter/depth_hough/debug_markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Queue Size: 10
  - Class: rviz_default_plugins/Map
    Name: lidar binary (debug)
    Enabled: false
    Topic:
      Value: /wall_plane_filter/lidar_hough/binary
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Alpha: 0.5
    Color Scheme: map
    Draw Behind: true
  - Class: rviz_default_plugins/MarkerArray
    Name: lidar stages (debug)
    Enabled: false
    Marker Topic:
      Value: /wall_plane_filter/lidar_hough/debug_markers
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 1
    Queue Size: 10
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 60
      Target Frame: base_link
      X: 0
      Y: 0
Window Geometry:
  Width: 1400
  Height: 900
